/* ============================================================
   MDI — Tactical Outdoor Ground Station Theme
   Version: 3.0
   Style: Modern Tactical Telemetry
   ============================================================ */

/* ─────────────────────────────────────────────────────────────
   GLOBAL
───────────────────────────────────────────────────────────── */

* {
    font-family: "IBM Plex Sans";
    font-size: 12px;
    color: #172033;
    background-color: transparent;
    outline: none;
}

QMainWindow,
QDialog,
QWidget#centralWidget,
QWidget#rootWidget {
    background-color: #edf2f7;
}

/* ─────────────────────────────────────────────────────────────
   TYPOGRAPHY
───────────────────────────────────────────────────────────── */

QLabel {
    color: #475569;
    font-size: 12px;
}

QLabel#sectionTitle {
    color: #172033;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

QLabel#statusHeading {
    color: #64748b;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.5px;
}

QLabel#statusValue {
    color: #2563eb;
    font-size: 14px;
    font-weight: 600;
    font-family: "IBM Plex Mono";
}

QLabel#statusOk {
    color: #16a34a;
    font-weight: 600;
}

QLabel#statusWarn {
    color: #f59e0b;
    font-weight: 600;
}

QLabel#statusError {
    color: #dc2626;
    font-weight: 600;
}

/* ─────────────────────────────────────────────────────────────
   SIDEBAR
───────────────────────────────────────────────────────────── */

QFrame#sidebar {
    background-color: #0b1220;
    border-right: 1px solid #1e293b;
}

QLabel#sidebarTitle {
    color: #f8fafc;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#sidebarSubtitle {
    color: #64748b;
    font-size: 10px;
    font-family: "IBM Plex Mono";
    letter-spacing: 1px;
}

QLabel#sidebarDivider {
    background-color: #1e293b;
    max-height: 1px;
    min-height: 1px;
}

QPushButton#navBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 12px 14px;
    color: #94a3b8;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#navBtn:hover {
    background-color: #172033;
    color: #ffffff;
}

QPushButton#navBtn:checked,
QPushButton#navBtn:pressed {
    background-color: #2563eb;
    color: #ffffff;
}

QLabel#sidebarConnLabel {
    color: #64748b;
    font-size: 10px;
    font-family: "IBM Plex Mono";
}

/* ─────────────────────────────────────────────────────────────
   HEADER
───────────────────────────────────────────────────────────── */

QWidget#headerPanel {
    background-color: #ffffff;
    border-bottom: 1px solid #dbe4ee;
}

QLabel#appTitle {
    color: #2563eb;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#appSubtitle {
    color: #64748b;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1px;
}

QFrame#card,
QFrame#cardAccent {
    background-color: #ffffff;
    border-radius: 10px;
    border: 1px solid #dbe4ee;
}

QFrame#cardAccent {
    border: 1px solid #2563eb;
}

/* ─────────────────────────────────────────────────────────────
   GROUP BOX
───────────────────────────────────────────────────────────── */

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #dbe4ee;
    border-radius: 8px;
    margin-top: 16px;
    padding: 16px 12px 12px 12px;
    color: #334155;
    font-size: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #2563eb;
    background-color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

/* ─────────────────────────────────────────────────────────────
   TAB
───────────────────────────────────────────────────────────── */

QTabWidget::pane {
    border: 1px solid #dbe4ee;
    background-color: #ffffff;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #e9eef5;
    color: #475569;
    padding: 8px 18px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
    font-size: 11px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #2563eb;
}

QTabBar::tab:hover {
    background-color: #dbeafe;
}

/* ─────────────────────────────────────────────────────────────
   INPUTS
───────────────────────────────────────────────────────────── */

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QTextEdit,
QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 7px 10px;
    color: #172033;
    font-size: 12px;
    selection-background-color: #bfdbfe;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus,
QTextEdit:focus {
    border: 1px solid #2563eb;
}

QLineEdit[readOnly="true"],
QTextEdit[readOnly="true"] {
    background-color: #f8fafc;
    color: #0f766e;
    font-family: "IBM Plex Mono";
}

/* ─────────────────────────────────────────────────────────────
   COMBO BOX
───────────────────────────────────────────────────────────── */

QComboBox::drop-down {
    width: 24px;
    border-left: 1px solid #dbe4ee;
    background-color: #f8fafc;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #dbe4ee;
    selection-background-color: #dbeafe;
    color: #172033;
}

/* ─────────────────────────────────────────────────────────────
   BUTTONS
───────────────────────────────────────────────────────────── */

QPushButton {
    background-color: #f8fafc;
    border: 1px solid #dbe4ee;
    border-radius: 7px;
    padding: 8px 16px;
    color: #172033;
    font-size: 11px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #e2e8f0;
}

QPushButton:pressed {
    background-color: #cbd5e1;
}

QPushButton:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

/* PRIMARY */

QPushButton#btnPrimary,
QPushButton#btnConnect {
    background-color: #2563eb;
    border: none;
    color: #ffffff;
}

QPushButton#btnPrimary:hover,
QPushButton#btnConnect:hover {
    background-color: #1d4ed8;
}

/* SUCCESS */

QPushButton#btnSave,
QPushButton#btnStart {
    background-color: #16a34a;
    border: none;
    color: #ffffff;
}

QPushButton#btnSave:hover,
QPushButton#btnStart:hover {
    background-color: #15803d;
}

/* DANGER */

QPushButton#btnStop {
    background-color: #dc2626;
    border: none;
    color: #ffffff;
}

QPushButton#btnStop:hover {
    background-color: #b91c1c;
}

/* WARNING */

QPushButton#btnReset {
    background-color: #f59e0b;
    border: none;
    color: #ffffff;
}

QPushButton#btnReset:hover {
    background-color: #d97706;
}

/* ─────────────────────────────────────────────────────────────
   CHECKBOX
───────────────────────────────────────────────────────────── */

QCheckBox {
    spacing: 8px;
    color: #334155;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #cbd5e1;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
}

/* ─────────────────────────────────────────────────────────────
   LIST WIDGET
───────────────────────────────────────────────────────────── */

QListWidget {
    background-color: #ffffff;
    border: 1px solid #dbe4ee;
    border-radius: 8px;
    padding: 4px;
}

QListWidget::item {
    padding: 8px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #dbeafe;
    color: #1d4ed8;
}

/* ─────────────────────────────────────────────────────────────
   SCROLLBAR
───────────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #94a3b8;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #64748b;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ─────────────────────────────────────────────────────────────
   LOG CONSOLE
───────────────────────────────────────────────────────────── */

QTextEdit#logConsole {
    background-color: #f8fafc;
    border: 1px solid #dbe4ee;
    border-radius: 8px;
    padding: 8px;
    color: #172033;
    font-family: "IBM Plex Mono";
    font-size: 11px;
}

/* ─────────────────────────────────────────────────────────────
   STATUS BAR
───────────────────────────────────────────────────────────── */

QStatusBar,
QFrame#bottomBar {
    background-color: #ffffff;
    border-top: 1px solid #dbe4ee;
    color: #64748b;
    font-size: 11px;
}

/* ─────────────────────────────────────────────────────────────
   TOOLTIP
───────────────────────────────────────────────────────────── */

QToolTip {
    background-color: #172033;
    color: #ffffff;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
}

/* ─────────────────────────────────────────────────────────────
   SPLITTER
───────────────────────────────────────────────────────────── */

QSplitter::handle {
    background-color: #dbe4ee;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ─────────────────────────────────────────────────────────────
   RADAR & TACTICAL 3D CANVAS
───────────────────────────────────────────────────────────── */

QWidget#radarCanvas,
QWidget#tactical3DCanvas,
QWidget#tactical3DWidget {
    background-color: #060d06;
    border: 1px solid #1a4a1a;
    border-radius: 8px;
}